@{
}
@model AlbumsApp.Models.Album

<div class="container mt-4">
    <h1>Album Details</h1>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <img src="@Model.CoverImageUrl" alt="@Model.Title"  />
        </div>
        <div class="col-md-4">
            <h3>@Model.Title</h3>
            <p><strong>Artist:</strong> @Model.Artist</p>
            <p><strong>Year:</strong> @Model.Year</p>
            <p><strong>Genre:</strong> @Model.Genre</p>

            <a asp-controller="Album" asp-action="Index" class="btn btn-primary mt-3">Back to Albums</a>
        </div>
    </div>
</div>
