@model AlbumsApp.Models.AlbumsIndex
@using AlbumsApp.Models
@{
    ViewData["Title"] = "All Albums";
}

<div class="container mt-3">

    <h2>Albums</h2>
@if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-success">@Model.AlertMessage</div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveGenre == null ? "active" : "")"
               asp-controller="Album" asp-action="Index">All</a>


        </li>

        @foreach(var i in Enum.GetValues<Genre>())
        {
            <li>
                <a class="nav-link @(Model.ActiveGenre == i ? "active" : "")"
                   asp-controller="Album" asp-action="Index" asp-route-genre="@i">@i</a>
            </li>
            
        }


    </ul>

    <div class="row">
        <div class="col-md-6">
            <h4>Albums List</h4>
            @if(Model.Albums.Any())
            {
                <ul class="list-group">
                    @foreach(var i in Model.Albums)
                    {
                       <li class="list-group-item">
                           "@i.Title" by @i.Artist (@i.Year)
                           <div class="mt-3">
                               <a class="btn btn-sm btn-primary" asp-controller="Album" asp-action="Details" asp-route-id="@i.Id">Details</a>

                           </div>
                       </li> 
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No Albums found for this genre</p>
            }
        </div>
        <div class="col-md-6">
            <h4>Featured Albums</h4>
            @if(Model.Featured != null)
            {
                <div class="card">
                    <div class="card-body">
                        "@Model.Featured.Title" by @Model.Featured.Artist (@Model.Featured.Year)

                    </div>
                    <img src="@Model.Featured.CoverImageUrl" alt="@Model.Featured.Title" class="img-fluid" />

                </div>
            }
            else
            {
                <p class="text-muted">No featured album available</p>
            }
        </div>
        <hr class="my-4" />
        <h5>Add new album</h5>
        @if(!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(x => x.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            
            </div>

        }

        <form asp-controller="Album" asp-action="AddAlbum" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CurrentGenre" value="@Model.ActiveGenre" />

            <div class="mb-2">
                <label class="form-label">Title</label>
                <input type="text" name="Title" class="form-control" value="@Model.NewAlbum.Title" />
            </div>

            <div class="mb-2">
                <label class="form-label">Artist</label>
                <input type="text" name="Artist" class="form-control" value="@Model.NewAlbum.Artist" />
            </div>

            <div class="mb-2">
                <label class="form-label">Year</label>
                <input type="number" name="Year" class="form-control" value="@Model.NewAlbum.Year" />
            </div>

            <div class="mb-2">
                <label class="form-label">Genre</label>
                <select name="Genre" class="form-select">
                    @foreach (var g in Enum.GetValues<Genre>())
                    {
                        <option value="@g" selected="@(Model.NewAlbum.Genre == g)">@g</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Cover Image URL</label>
                <input type="text" name="CoverImageUrl" class="form-control" value="@Model.NewAlbum.CoverImageUrl" />
            </div>

            <button type="submit" class="btn btn-primary">Add</button>
        </form>

    </div>
    
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
